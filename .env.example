# Template. Copy to .env and fill in.

# --- Azure Application Insights (Phase 2b) ---------------------------------
# PASTE YOUR CONNECTION STRING BELOW, on one line, no quotes needed.
# It looks like:
#   InstrumentationKey=<guid>;IngestionEndpoint=https://westus2-0.in.applicationinsights.azure.com/;LiveEndpoint=...;ApplicationId=<guid>
# Read by the COLLECTOR (via otel/run_collector.ps1), not by the agent.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<guid>;IngestionEndpoint=https://westus2-0.in.applicationinsights.azure.com/

# If outbound HTTPS to *.in.applicationinsights.azure.com goes through a
# corporate proxy, set it here. run_collector.ps1 loads it for the collector.
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=127.0.0.1,localhost

# --- Org telemetry attributes (dashboards filter on tenantId) --------------
TELEMETRY_TENANT_ID=a54b2e21-ad8b-4279-bf35-2d63bd5eedf3
TELEMETRY_ORIGIN_COMPONENT=research-agent
TELEMETRY_AGENT_ID=b7d4e1a2-3f65-4c08-9e71-5a2c8d4f6b93

# --- Agent -----------------------------------------------------------------
# RESEARCH_AGENT_MODEL=claude-sonnet-5
# RESEARCH_AGENT_EFFORT=medium
# RESEARCH_AGENT_MAX_TURNS=20

# --- Telemetry -------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=research-agent        # becomes AppRoleName in Azure
# AGENT_TELEMETRY_ENABLED=0               # run without emitting telemetry
# OTEL_LOG_ASSISTANT_RESPONSES=1          # also log full report bodies (large)
